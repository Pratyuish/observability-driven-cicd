{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "inc-003",
    "namespace": "ai-incidents"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "inc-003"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "inc-003"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "nginx:1.27",
            "envFrom": [
              {
                "configMapRef": {
                  "name": "missing-app-config",
                  "optional": false
                }
              }
            ]
          }
        ]
      }
    }
  }
}