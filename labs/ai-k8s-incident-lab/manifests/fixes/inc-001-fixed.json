{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "inc-001",
    "namespace": "ai-incidents"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "inc-001"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "inc-001"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "nginx:1.27",
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 80
              },
              "initialDelaySeconds": 2,
              "periodSeconds": 5
            }
          }
        ]
      }
    }
  }
}